{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenSOVD Offline Capability Description",
    "version": "0.1.0",
    "description": "Offline capability artifact with x-sovd-applicability examples."
  },
  "servers": [
    {
      "url": "https://{sovd-server-host}/sovd/v1"
    }
  ],
  "paths": {
    "/components/PowerSteering/data/SteeringWheelRotationSpeed": {
      "x-sovd-applicability": {
        "variants": [
          {
            "source": "/components/PowerSteering#variant",
            "values": [
              "Pow_Str_Variant_High"
            ]
          }
        ],
        "versions": [
          {
            "source": "/components/PowerSteering/data/swVersion",
            "match": "semver",
            "values": [
              "1.0.x"
            ]
          }
        ]
      },
      "get": {
        "summary": "Read steering wheel rotation speed",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/components/PowerSteering/data/SteeringMonitors": {
      "x-sovd-applicability": {
        "versions": [
          {
            "source": "/components/PowerSteering/data/swVersion",
            "match": "semver",
            "values": [
              "1.1.x"
            ]
          }
        ]
      },
      "get": {
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "SteeringTorque": {
                      "type": "number"
                    },
                    "SteeringWheelAngle": {
                      "type": "number"
                    },
                    "SteeringWheelRotationSpeed": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/components/PowerSteering/data/SteeringAssistMode": {
      "x-sovd-applicability": {
        "variants": [
          {
            "source": "/components/PowerSteering#variant",
            "match": "rule",
            "values": [
              "actual == \"Pow_Str_Variant_High\""
            ]
          }
        ]
      },
      "get": {
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
