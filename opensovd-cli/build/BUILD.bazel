load("//bazel:rust_crate.bzl", "workspace_rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

workspace_rust_library(
    name = "libcli_build",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "time",
    ],
    crate_name = "libcli_build",
    crate_root = "src/lib.rs",
    version = "0.1.1",
)