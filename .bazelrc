# Keep the Bazel bootstrap local-only for now. This avoids remote module
# resolution and lets Bazel drive the existing Cargo workspace directly.
startup --host_jvm_args=-Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts
startup --host_jvm_args=-Djavax.net.ssl.trustStorePassword=changeit
common --noenable_bzlmod
common --enable_workspace
common --incompatible_autoload_externally=
common --distdir=.cache/distfiles
common --@rules_rust//rust/toolchain/channel=nightly